# HeadHunter OAuth

# HeadHunter HTTP and retry envelope
HH_CONNECT_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT=30
HH_MAX_HTTP_ATTEMPTS=4
HH_MAX_RETRY_AFTER_SECONDS=30
CANDIDATE_POOL_V3_CHECKPOINT_MARGIN_SECONDS=30
HH_WORKER_TIMEOUT_SECONDS=300
OPERATION_LOCK_TTL_SECONDS=360
QUEUE_VISIBILITY_TIMEOUT_SECONDS=360
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_BEARER=
HH_REFRESH_TOKEN=
EMPLOYER_ID=
HH_USER_AGENT=Recruitment-Assistant/1.0

# NanoGPT
NANO_GPT_API_KEY=
API_NANO_URL=https://api.nano-gpt.com/api/v1/chat/completions
MODEL_NANO=alibaba/qwen3.8-flash

# Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_PORT=587
GMAIL_TIMEOUT_SECONDS=30

# Recruitment defaults
RESUMES_TO_FIND=2

# Parallel processing
GENERAL_CONSUMERS=16
XRAY_CONSUMERS=8
BROWSER_MAX_SESSIONS=8
